{
  "name": "order-outbox-connector",
  "config": {

    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",

    "database.hostname": "order_db",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.dbname": "postgres",
    "database.server.name": "orders_db",

    "tombstones.on.delete": "false",

    "plugin.name": "pgoutput",
    "slot.name": "outbox_slot",
    "table.include.list": "public.outbox_event",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
    "binary.handling.mode": "bytes",
    "topic.prefix": "orders",

    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.key.field" : "aggregate_id",
    "transforms.outbox.value.field" : "payload",
    "transforms.outbox.header.fields" : "event_type, schema_version, created_at",

    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",

    "snapshot.mode": "initial",

    "publication.autocreate.mode": "filtered",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "orders-outbox.DLT",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true"
  }
}

